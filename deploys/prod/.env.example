# =============================================================================
# RMS - Produzione (cremisi.shop)
# Copiare in .env e compilare tutti i valori prima di avviare.
# =============================================================================

BASE_DOMAIN=cremisi.shop

# Database
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=rms_db

# Backend
JWT_SECRET=                          # min 32 caratteri, generare con: openssl rand -hex 32
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
CORS_ORIGINS=https://cremisi.shop,https://admin.cremisi.shop
RATE_LIMIT_TTL=900
RATE_LIMIT_MAX=100
SUPERADMIN_PASSWORD=                 # password superadmin al primo avvio

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=                    # min 8 caratteri
MINIO_BUCKET=rms-images
MINIO_PUBLIC_BASE_URL=https://cremisi.shop/files
