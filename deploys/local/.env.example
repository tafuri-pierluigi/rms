# =============================================================================
# RMS - Sviluppo locale
# I default nel compose sono già funzionanti. Creare .env solo per override.
# =============================================================================

# Database (default: postgres/postgres/rms_db)
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=rms_db

# Backend
# JWT_SECRET=local_dev_secret_change_me_32chars
# SUPERADMIN_PASSWORD=Password123!
# CORS_ORIGINS=http://localhost:5173

# MinIO (default: minioadmin/minioadmin123)
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_PUBLIC_BASE_URL=http://localhost:9000/rms-images
