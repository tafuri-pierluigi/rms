# =============================================================================
# RMS - Collaudo (https://local.cremisi.shop:8443)
# I default nel compose sono già funzionanti. Creare .env solo per override.
# Prerequisito /etc/hosts: <IP-MACCHINA> local.cremisi.shop
# HTTPS via Caddy CA locale: estrarre CA con `scripts/export-caddy-ca.sh test`
# =============================================================================

# BASE_DOMAIN=local.cremisi.shop

# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=rms_db
# JWT_SECRET=test_secret_change_me_32_chars_min
# SUPERADMIN_PASSWORD=Password123!
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
